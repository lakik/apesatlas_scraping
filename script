# Function to get all page titles (unverändert)
fcs_get_all_page_titles <- function(api_url) {
  all_titles <- c()
  apcontinue <- NULL
  
  repeat {
    req <- request(api_url) %>%
      req_body_form(
        action = "query",
        list = "allpages",
        format = "json",
        aplimit = "max",
        apcontinue = apcontinue
      )
    
    response <- req %>%
      req_timeout(seconds = 60) %>%
      req_perform() %>%
      resp_body_json()
    
    pages <- response$query$allpages
    titles <- sapply(pages, function(page) page$title)
    all_titles <- c(all_titles, titles)
    
    if (!is.null(response$continue$apcontinue)) {
      apcontinue <- response$continue$apcontinue
    } else {
      break
    }
  }
  
  return(all_titles)
}

#*********************************************************************************************************************************
# OPTIMIERTE Batch-Funktion zum Abrufen mehrerer Seiten gleichzeitig
fcs_get_mediawiki_pages_batch <- function(api_url, page_titles, chunk_size = 50) {
  # Teile page_titles in Chunks
  chunks <- split(page_titles, ceiling(seq_along(page_titles) / chunk_size))
  
  # Erstelle parallele Batch-Requests
  reqs <- lapply(chunks, function(chunk_titles) {
    request(api_url) %>%
      req_url_query(
        action = "query",
        prop = "revisions",
        titles = paste(chunk_titles, collapse = "|"),
        rvprop = "content",
        format = "json"
      ) %>%
      req_throttle(rate = 10/1)  # Max 10 Requests pro Sekunde (API-Limit beachten)
  })
  
  # Führe alle Requests parallel aus
  cat(paste0("\nCollecting ", length(page_titles), " pages in ", length(chunks), " batch requests...\n"))
  resps <- req_perform_parallel(reqs, progress = TRUE)
  
  # Extrahiere Content aus allen Responses
  all_content <- list()
  
  for (resp in resps) {
    pages <- resp_body_json(resp)$query$pages
    
    for (page_id in names(pages)) {
      if (page_id != "-1" && !is.null(pages[[page_id]]$revisions)) {
        page_title <- pages[[page_id]]$title
        content <- pages[[page_id]]$revisions[[1]]$`*`
        all_content[[page_title]] <- content
      }
    }
  }
  
  # Sortiere nach ursprünglicher Reihenfolge
  page_content <- lapply(page_titles, function(title) {
    all_content[[title]]
  })
  
  return(page_content)
}

#*********************************************************************************************************************************
# Original Conversion-Funktion (unverändert)
fcs_conv_wiki_to_df <- function(xt, tabxn, bc) {
  mc <- subset(xt, xt$part == tabxn & (xt$type == "Table_content" | xt$type == "Table_heading"))
  
  if (nrow(mc) > 0) {
    if (sum(mc$type == "Table_heading") > 0) {
      ncolx <- sum(mc$type == "Table_heading")
      headers <- mc$content[mc$type == "Table_heading"]
    } else {
      if (mc$part[1] == "Site_characteristics") {
        ncolx <- 2
      }
      headers <- c("type", "value")
    }
    
    nt <- matrix(mc$content[mc$type != "Table_heading"], ncol = ncolx, byrow = TRUE)
    nt <- data.frame(
      site = rep(mc$site[1], nrow(nt)),
      country = rep("", nrow(nt)),
      region = rep("", nrow(nt)),
      nt
    )
    colnames(nt) <- c("site", "country", "region", headers)
    nt$country <- bc$country[match(nt$site, bc$site)]
    nt$region <- bc$region[match(nt$site, bc$site)]
  } else {
    nt <- NA
  }
  
  return(nt)
}

#*********************************************************************************************************************************
# HAUPTFUNKTION mit optimiertem Scraping
scrape_apesatlas <- function(path_to_save) {
  
  api_url <- "https://apesatlas.iucnapesportal.org/api.php"
  
  #*********************************************************************************************************************************
  # COLLECT ALL PAGE TITLES
  cat(paste0("\nCollecting page titles from APES atlas...\n"))
  page_all <- fcs_get_all_page_titles(api_url)
  cat(paste0("Found ", length(page_all), " pages total.\n"))
  
  #*********************************************************************************************************************************
  # COLLECT ALL PAGES CONTENT - OPTIMIERT mit Batch + Parallel
  page_content <- fcs_get_mediawiki_pages_batch(api_url, page_all, chunk_size = 50)
  
  #*********************************************************************************************************************************
  # SELECT ONLY CONTENT PAGES
  xlog_page_type <- lapply(1:length(page_all), function(i) {
    content <- strsplit(page_content[[i]], split = "\n")[[1]]
    if (sum(grepl("]] > [[", content[1], fixed = TRUE)) > 0) {
      return("site content page")
    } else {
      return("other")
    }
  })
  
  type_table <- data.frame(page_all, unlist(xlog_page_type))
  page_sel <- page_all[which(type_table[, 2] == "site content page")]
  page_sel <- page_sel[!page_sel %in% c("Test", "Test1", "Testseite")]
  
  cat(paste0("\nFound ", length(page_sel), " content pages after filtering.\n"))
  
  #*********************************************************************************************************************************
  # FILTER PAGE CONTENT
  sel <- which(page_all %in% page_sel)
  page_content <- page_content[sel]
  
  #*********************************************************************************************************************************
  # EXTRACT PAGE SECTIONS
  cat(paste0("\nExtracting tables from collected APES atlas pages...\n"))
  pb <- txtProgressBar(min = 0, max = length(page_sel), style = 3)
  
  tf_all <- lapply(1:length(page_sel), function(i) {
    setTxtProgressBar(pb, i)
    
    content <- strsplit(page_content[[i]], split = "\n")[[1]]
    
    if (length(content) != 0) {
      xdivst <- which(grepl("<div", content, fixed = TRUE))
      xdiven <- which(grepl("</div>", content, fixed = TRUE))
      
      if (length(xdivst) > 0) {
        xdiv <- data.frame(st = xdivst, en = xdiven)
        
        tf <- lapply(1:nrow(xdiv), function(j) {
          xst <- xdiv$st[j]
          xen <- xdiv$en[j]
          xcontent <- content[xst:xen]
          
          part_name <- gsub(".*id=\"", "", xcontent[1])
          part_name <- gsub("\".*", "", part_name)
          
          table_rows <- grep("\\|", xcontent, value = TRUE)
          
          if (length(table_rows) > 0) {
            parsed_rows <- lapply(table_rows, function(row) {
              row_clean <- gsub("^\\|", "", row)
              row_clean <- gsub("\\|$", "", row_clean)
              
              type <- if (grepl("!", row_clean)) "Table_heading" else "Table_content"
              row_clean <- gsub("!", "", row_clean)
              
              data.frame(
                site = page_sel[i],
                part = part_name,
                type = type,
                content = row_clean,
                stringsAsFactors = FALSE
              )
            })
            
            return(do.call(rbind, parsed_rows))
          }
        })
        
        tf <- do.call(rbind, tf)
        return(tf)
      }
    }
    
    return(NULL)
  })
  
  close(pb)
  
  # Kombiniere alle Ergebnisse
  tf_all <- do.call(rbind, tf_all)
  
  #*********************************************************************************************************************************
  # SAVE RESULTS
  if (!is.null(path_to_save)) {
    saveRDS(tf_all, file = paste0(path_to_save, "/apesatlas_scraped_data.rds"))
    cat(paste0("\nData saved to: ", path_to_save, "/apesatlas_scraped_data.rds\n"))
  }
  
  return(tf_all)
}

